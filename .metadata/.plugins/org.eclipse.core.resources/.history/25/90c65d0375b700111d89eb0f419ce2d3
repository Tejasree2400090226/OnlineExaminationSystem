spring.application.name=APIGateway



spring.application.name=APIGateway

server.port=8080

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true


# Auth Service
spring.cloud.gateway.server.webflux.routes[0].id=AuthService
spring.cloud.gateway.server.webflux.routes[0].uri=lb://AuthService
spring.cloud.gateway.server.webflux.routes[0].predicates[0]=Path=/auth/**


# Exam Service
spring.cloud.gateway.server.webflux.routes[1].id=ExamService
spring.cloud.gateway.server.webflux.routes[1].uri=lb://ExamService
spring.cloud.gateway.server.webflux.routes[1].predicates[0]=Path=/exams/**


# Submission Service
spring.cloud.gateway.server.webflux.routes[2].id=SubmissionService
spring.cloud.gateway.server.webflux.routes[2].uri=lb://SubmissionService
spring.cloud.gateway.server.webflux.routes[2].predicates[0]=Path=/submissions/**


# Evaluation Service
spring.cloud.gateway.server.webflux.routes[3].id=EvaluationService
spring.cloud.gateway.server.webflux.routes[3].uri=lb://EvaluationService
spring.cloud.gateway.server.webflux.routes[3].predicates[0]=Path=/evaluations/**